APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Keep false for local HTTP development. Set true on HTTPS production.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Enrollee verification and status emails send immediately through this mailer.
# Port 587: leave MAIL_SCHEME empty. Port 465: MAIL_SCHEME=smtps. Do not set MAIL_SCHEME=tls.

# Email 2FA uses Laravel's SMTP/Symfony Mailer transport (PHPMailer is not required).
# For Gmail, use an app password rather than your normal account password.
TWO_FACTOR_ENABLED=true
TWO_FACTOR_ROLES=admin
TWO_FACTOR_TTL=10
TWO_FACTOR_MAX_ATTEMPTS=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Official training documents are private and rendered by a queue worker.
OFFICIAL_DOCUMENT_DISK=local
OFFICIAL_DOCUMENT_TEMPLATE_VERSION=1.0
OFFICIAL_DOCUMENT_EXPORT_EXPIRY_HOURS=24
# auto uses Chrome/Node when both are installed; otherwise PHP/FPDF (shared hosting).
OFFICIAL_DOCUMENT_PDF_ENGINE=auto
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=
BROWSERSHOT_CHROME_PATH=
MCARE_ORGANIZATION_NAME="Mission Care Training Center"
MCARE_ORGANIZATION_ADDRESS="San Isidro Poblacion, Pili, Camarines Sur"
MCARE_ORGANIZATION_PHONE=09298202898
MCARE_TRAINER_SIGNATORY="Maricris N. Collao"
MCARE_REGISTRAR_SIGNATORY="Salvacion A. Collao"
MCARE_CAREGIVING_HOURS=786

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Authorized redirect URIs exactly (path is /auth/google/callback, not /login/...).
# Register both http://localhost:8000/auth/google/callback and http://127.0.0.1:8000/auth/google/callback for local artisan serve.
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

PSGC_API_URL=https://psgc.gitlab.io/api
PSGC_API_TIMEOUT=5

SEMAPHORE_API_KEY=
# Must match an approved sender name in your Semaphore account.
SEMAPHORE_SENDER_NAME=

# Landing-page MCARE assistant. Never expose this key in frontend code.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=30

PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_LIVE_MODE=false
PAYMONGO_PAYMENT_METHODS=gcash,card,qrph

# Production reminder:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-real-domain.example
# SESSION_SECURE_COOKIE=true
# LOG_LEVEL=warning
